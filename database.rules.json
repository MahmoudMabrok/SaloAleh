    "mohamed_lovers": {
      "allTimeTotal": {
        ".read": true,
        ".write": false
      },
      "app_config": {
        ".read": true,
        ".write": false
      },
      "heroes": {
        ".read": true,
        ".write": false
      },
      "abnormal_users": {
        ".read": false,
        ".write": false
      },
      "referral_codes": {
        "$code": {
          ".read": true,
          ".write": "!data.exists() || data.val() === newData.val()",
          ".validate": "newData.isString() && newData.val().length > 0"
        }
      },
      "referral_stats": {
        "$code": {
          ".read": true,
          ".write": false
        }
      },
      "users": {
        "$uid": {
          ".read": false,
          ".write": "auth == null || auth.uid != null",
          "fcmToken": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "installDate": {
            ".validate": "newData.isString() && newData.val().length == 10"
          },
          "lastOpenDate": {
            ".validate": "newData.isString() && newData.val().length == 10"
          },
          "appVersion": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
          },
          "appVersionCode": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "lastRivalNotifDate": {
            ".validate": "newData.isString() && newData.val().length == 10"
          },
          "lastDropOutNotifRound": {
            ".validate": "newData.isString()"
          },
          "lastTenDaysDropOutNotif": {
            ".validate": "newData.isString()"
          },
          "lastTenDaysRivalNotif": {
            ".validate": "newData.isString()"
          },
          "lastTenDaysInactiveNotif": {
            ".validate": "newData.isString()"
          },
          "allTimeTotal": {
            ".read": true,
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "referralCode": {
            ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 12"
          },
          "referredBy": {
            ".validate": "newData.isString() && !data.exists()"
          },
          "referrals": {
            "$referredUid": {
              ".validate": "newData.isBoolean()"
            }
          },
          "isSupporter": {
            ".validate": "newData.isBoolean()"
          },
          "reminderNotifsEnabled": {
            ".validate": "newData.isBoolean()"
          },
          "leaderboardNotifsEnabled": {
            ".validate": "newData.isBoolean()"
          },
          "achievements": {
            ".read": true,
            ".write": false,
            "$roundKey": {
              ".validate": "newData.hasChildren(['rank', 'score', 'date'])"
            }
          },
          "medals": {
            ".read": true,
            ".validate": false,
            "$medalType": {
              ".validate": false
            }
          },
          "scoreHistory": {
            ".validate": false,
            "$dateKey": {
              ".validate": false
            }
          },
          "paceFlags": {
            ".validate": false,
            "$dateKey": {
              ".validate": false
            }
          },
          "purchases": {
            "$productId": {
              ".validate": "newData.hasChildren(['productId', 'productType', 'purchaseDate'])",
              "productId": {
                ".validate": "newData.isString() && newData.val() === $productId"
              },
              "productType": {
                ".validate": "newData.isString() && (newData.val() === 'ONE_TIME' || newData.val() === 'SUBSCRIPTION')"
              },
              "purchaseDate": {
                ".validate": "newData.isString() && newData.val().length == 10"
              },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "$round": {
        "roundTotal": {
          ".read": true,
          ".write": false
        },
        "leaderboard": {
          ".read": true,
          ".write": false
        },
        "dailyLeaderboard": {
          ".read": true,
          ".write": false
        },
        "roundPlayerCount": {
          ".read": true,
          ".write": false
        },
        "players": {
          ".read": true,
          ".indexOn": ["totalCount"],
          "$uid": {
            ".write": "newData.child('uid').val() === $uid",
            ".validate": "newData.hasChildren(['uid', 'schemaVersion'])",

            "uid": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "schemaVersion": {
              ".validate": "newData.isNumber() && newData.val() >= 1"
            },
            "countryCode": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 3"
            },
            "totalCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.parent().child('yesterdayTotalScore').exists() ? data.parent().child('yesterdayTotalScore').val() : 0) + 25000"
            },
            "yesterdayTotalScore": {
              ".read": true,
              ".write": false
            },
            "todayCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "updatedAt": {
              ".validate": "newData.val() === now"
            },
            "isWinner": {
              ".validate": "newData.val() === (data.exists() ? data.val() : false)"
            },
            "winnerCode": {
              ".validate": "newData.val() === (data.exists() ? data.val() : '')"
            },
            "scoreMasked": {
              ".validate": "newData.isBoolean()"
            },
            "totalExternal": {
              ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0)"
            },
            "externalLog": {
              "$entryKey": {
                ".validate": "newData.isNumber()"
              }
            },
            "externalDaily": {
              "$dayKey": {
                ".validate": "newData.isNumber()"
              }
            },
            "dailyBadge": {
              ".validate": "newData.isString()"
            },
            "roundStreak": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "isSupporter": {
              ".validate": "newData.isBoolean()"
            },
            "nickname": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },

            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
