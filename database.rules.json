{
  "rules": {
    ".read": false,
    ".write": false,

    "ten_days_dhul_hijjah": {
      "$periodKey": {
        "leaderboard": {
          ".read": true,
          ".write": false
        },
        "players": {
          ".indexOn": ["totalScore"],
          "$uid": {
            ".write": "newData.child('uid').val() === $uid",
            ".validate": "newData.hasChildren(['uid','totalScore','updatedAt','countryCode'])",

            "uid": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "totalScore": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "updatedAt": {
              ".validate": "newData.val() === now"
            },
            "countryCode": {
              ".validate": "newData.isString()"
            },
            "rank": {
              ".read": true,
              ".write": false
            },

            "$other": { ".validate": false }
          }
        }
      }
    },

    "mohamed_lovers": {
      "allTimeTotal": {
        ".read": true,
        ".write": false
      },
      "users": {
        "$uid": {
          ".read": false,
          ".write": "auth == null || auth.uid != null",
          "fcmToken": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "installDate": {
            ".validate": "newData.isString() && newData.val().length == 10"
          },
          "lastOpenDate": {
            ".validate": "newData.isString() && newData.val().length == 10"
          },
          "lastRivalNotifDate": {
            ".validate": "newData.isString() && newData.val().length == 10"
          },
          "lastDropOutNotifRound": {
            ".validate": "newData.isString()"
          },
          "lastTenDaysDropOutNotif": {
            ".validate": "newData.isString()"
          },
          "lastTenDaysRivalNotif": {
            ".validate": "newData.isString()"
          },
          "lastTenDaysInactiveNotif": {
            ".validate": "newData.isString()"
          },
          "achievements": {
            ".read": true,
            ".write": false,
            "$roundKey": {
              ".validate": "newData.hasChildren(['rank', 'score', 'date'])"
            }
          },
          "$other": { ".validate": false }
        }
      },
      "$round": {
        "roundTotal": {
          ".read": true,
          ".write": false
        },
        "leaderboard": {
          ".read": true,
          ".write": false
        },
        "dailyLeaderboard": {
          ".read": true,
          ".write": false
        },
        "roundPlayerCount": {
          ".read": true,
          ".write": false
        },
        "players": {
          ".read": true,
          ".indexOn": ["totalCount"],
          "$uid": {
            ".write": "newData.child('uid').val() === $uid",
            ".validate": "newData.hasChildren(['uid','totalCount','updatedAt','countryCode'])",

            "uid": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "countryCode": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 3"
            },
            "totalCount": {
              ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 10000"
            },
            "yesterdayTotalScore": {
              ".read": true,
              ".write": false
            },
            "updatedAt": {
              ".validate": "newData.val() === now"
            },
            "isWinner": {
              ".validate": "newData.val() === (data.exists() ? data.val() : false)"
            },
            "winnerCode": {
              ".validate": "newData.val() === (data.exists() ? data.val() : '')"
            },
            "scoreMasked": {
              ".validate": "newData.isBoolean()"
            },

            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
