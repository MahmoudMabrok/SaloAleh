{
  "rules": {
    ".read": false,
    ".write": false,

    "mohamed_lovers": {
      "allTimeTotal": {
        ".read": true,
        ".write": false
      },
      "users": {
        "$uid": {
          ".read": false,
          ".write": "auth == null || auth.uid != null",
          "fcmToken": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "installDate": {
            ".validate": "newData.isString() && newData.val().length == 10"
          },
          "lastOpenDate": {
            ".validate": "newData.isString() && newData.val().length == 10"
          },
          "lastRivalNotifDate": {
            ".validate": "newData.isString() && newData.val().length == 10"
          },
          "achievements": {
            ".read": true,
            ".write": false,
            "$roundKey": {
              ".validate": "newData.hasChildren(['rank', 'score', 'date'])"
            }
          },
          "$other": { ".validate": false }
        }
      },
      "handoffs": {
        "$nonce": {
          ".read": "$nonce.length >= 16",
          ".write": "$nonce.length >= 16 && $nonce.length <= 64 && newData.exists() && !data.exists()",
          ".validate": "newData.hasChildren(['consumedAt','byUid','round','count'])",
          "consumedAt": {
            ".validate": "newData.val() === now"
          },
          "byUid": {
            ".validate": "newData.isString() && newData.val().length === 64"
          },
          "round": {
            ".validate": "newData.isString() && newData.val().length === 10"
          },
          "count": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "$other": { ".validate": false }
        }
      },
      "$round": {
        "roundTotal": {
          ".read": true,
          ".write": false
        },
        "leaderboard": {
          ".read": true,
          ".write": false
        },
        "dailyLeaderboard": {
          ".read": true,
          ".write": false
        },
        "roundPlayerCount": {
          ".read": true,
          ".write": false
        },
        "players": {
          ".read": true,
          ".indexOn": ["totalCount"],
          "$uid": {
            ".write": "newData.child('uid').val() === $uid",
            ".validate": "newData.hasChildren(['uid','totalCount','updatedAt','countryCode'])",

            "uid": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "countryCode": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 3"
            },
            "totalCount": {
              ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 10000"
            },
            "yesterdayTotalScore": {
              ".read": true,
              ".write": false
            },
            "updatedAt": {
              ".validate": "newData.val() === now"
            },
            "isWinner": {
              ".validate": "newData.val() === (data.exists() ? data.val() : false)"
            },
            "winnerCode": {
              ".validate": "newData.val() === (data.exists() ? data.val() : '')"
            },

            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
