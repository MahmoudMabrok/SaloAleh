{
  "rules": {
    ".read": false,
    ".write": false,

    "baqiyat_saliha": {
      "totalBaqiyat": {
        ".read": true,
        ".write": false
      },
      "users": {
        "$uid": {
          "medals": {
            ".read": true,
            ".validate": false,
            "$medalType": {
              ".validate": false
            }
          },
          "totalCount": {
            ".read": true,
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      },
      "$dateKey": {
        "participantCount": {
          ".read": true,
          ".write": false
        },
        "totalTodayBaqiyat": {
          ".read": true,
          ".write": false
        },
        "lastRankedAt": {
          ".read": true,
          ".write": false
        },
        "leaderboard": {
          ".read": true,
          ".write": false
        },
        "players": {
          ".read": true,
          ".indexOn": ["count"],
          "$uid": {
            ".write": "newData.child('uid').val() === $uid",

            "uid": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "count": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000"
            },
            "streak": {
              ".read": true,
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "rank": {
              ".read": true,
              ".validate": "newData.val() === data.val()"
            }
          }
        }
      }
    },

    "ten_days_dhul_hijjah": {
      "$periodKey": {
        "leaderboard": {
          ".read": true,
          ".write": false
        },
        "playerCount": {
          ".read": true,
          ".write": false
        },
        "players": {
          ".indexOn": ["totalScore"],
          "$uid": {
            ".write": "newData.child('uid').val() === $uid",
            ".validate": "newData.hasChildren(['uid','totalScore','updatedAt','countryCode'])",

            "uid": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "totalScore": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "updatedAt": {
              ".validate": "newData.val() === now"
            },
            "countryCode": {
              ".validate": "newData.isString()"
            },
            "rank": {
              ".read": true,
              ".write": false
            },

            "$other": { ".validate": false }
          }
        }
      }
    },

    "100_challenge": {
      "totalDhkr": {
        ".read": true,
        ".write": false
      },
      "users": {
        "$uid": {
          "medals": {
            ".read": true,
