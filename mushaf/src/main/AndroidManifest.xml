<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:dist="http://schemas.android.com/apk/distribution"
    xmlns:tools="http://schemas.android.com/tools">

    <dist:module
        dist:instant="false"
        dist:title="@string/mushaf_feature_title">
        <dist:delivery>
            <dist:on-demand />
        </dist:delivery>
        <dist:fusing dist:include="false" />
    </dist:module>

    <!-- The page reader does not play recitation. This permission is what made
         Play reject the upload until a new foreground-service declaration. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:node="remove" />

    <application>
        <activity
            android:name=".MushafReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication" />

        <service
            android:name="com.mushafimad.core.data.audio.AudioPlaybackService"
            tools:node="remove" />

        <!-- These run before Application.onCreate. Play still lists them while
             this module is not installed, so the process dies on launch with
             ClassNotFoundException. The reader starts the library itself. -->
        <provider
            android:name="com.mushafimad.core.internal.MushafInitProvider"
            android:authorities="${applicationId}.mushaf-initializer"
            tools:node="remove" />
        <provider
            android:name="com.mushafimad.ui.internal.MushafUiInitProvider"
            android:authorities="${applicationId}.mushaf-ui-initializer"
            tools:node="remove" />

        <!-- Do not register Realm on process start. Its native library is in
             this split, so the base app crashes with ClassNotFoundException
             before the user downloads the Mushaf. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="io.realm.kotlin.internal.RealmInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
