{
  "manifest_version": 3,
  "name": "SaloAleh — عداد الصلوات",
  "short_name": "SaloAleh",
  "version": "1.0.0",
  "description": "عداد للصلاة على النبي ﷺ من المتصفح، مع كود QR لإرسال النتيجة إلى تطبيق الجوال.",
  "default_locale": "ar",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://kamapp-3b3ac-default-rtdb.firebaseio.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SaloAleh",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
