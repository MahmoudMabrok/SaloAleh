<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-to-device transfer rules — applied on API 31+.
  https://developer.android.com/about/versions/12/backup-restore

  Empty <cloud-backup/> and <device-transfer/> mean: include everything
  by default. See backup_rules.xml for the rationale and for the FCM
  token freshness handling.
-->
<data-extraction-rules>
    <cloud-backup/>
    <device-transfer/>
</data-extraction-rules>
